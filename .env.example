# 复制为 .env 后按需修改：cp .env.example .env

# ---- LLM / Embedding（config/config.yaml 中 llm.api_key_env、embeddings.api_key_env 引用的 key）----
# 默认使用阿里云 DashScope（deepseek-v3.2 / text-embedding-v4）
DASHSCOPE_API_KEY=

# 若改用 OpenAI 兼容的模型/嵌入服务，配置这个（DASHSCOPE_API_KEY 未设置时会回退用它）
OPENAI_API_KEY=

# ---- 数据库 ----
# 不设置则默认使用 sqlite:///vectorstore/ragify.db
RAGIFY_DATABASE_URL=

# ---- 认证 ----
# JWT 签名密钥；不设置会在进程启动时生成临时密钥，重启后所有登录状态失效，生产环境务必固定配置
RAGIFY_JWT_SECRET=

# 前端地址，用于登录/邀请等场景拼接跳转链接，默认 http://localhost:3000
RAGIFY_FRONTEND_URL=

# MCP server 启动时用于解析当前会话所属租户的登录 token（通过 /api/auth/login 获取）
RAGIFY_MCP_TOKEN=

# ---- 邮件发送（SMTP，用于邀请/通知等功能）----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
